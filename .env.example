# OpenRouter API key for real chat completions and web search.
# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Venice API key for the Venice models and the Venice-backed MCP endpoint.
# Get one at https://venice.ai/settings/api
VENICE_API_KEY=

# FAL API key for real image and video generation.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Server secret for the OpenAI-compatible API authorization flow.
UMBRA_API_SECRET=

# Optional treasury address for USDG credit funding on Robinhood Chain.
# Must be a 40-hex-character EVM address.
NEXT_PUBLIC_UMBRA_TREASURY=

# Optional WalletConnect project ID. WalletConnect is hidden when empty.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
